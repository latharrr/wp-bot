# --- Core API ---
API_KEY=change-me-api-key
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY_HOURS=24

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_POLL_HISTORY_RPC=get_poll_user_history

# --- WhatsApp bridge ---
WHATSAPP_BRIDGE_ENABLED=true
WHATSAPP_INTERNAL_TOKEN=change-me-internal-token
WHATSAPP_INTERNAL_BASE_URL=http://127.0.0.1:8000
WHATSAPP_BRIDGE_CONTROL_URL=http://127.0.0.1:8801
WHATSAPP_BRIDGE_CONTROL_TOKEN=change-me-control-token
WHATSAPP_USE_PAIRING_CODE=true
WHATSAPP_PHONE_NUMBER=
BAILEYS_PROJECT_DIR=whatsapp_bridge
BAILEYS_AUTH_DIR=whatsapp_bridge/baileys_auth_info
BAILEYS_LOG_LEVEL=info
BAILEYS_LOG_DIR=whatsapp_bridge/logs

# --- SMTP alerts (optional; logout alerts only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
WHATSAPP_ALERT_RECIPIENTS=

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
